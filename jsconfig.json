{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "paths": {
      "punycode": [
        "./node_modules/@types/node/punycode.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "eslint.config.js"
  ]
}
