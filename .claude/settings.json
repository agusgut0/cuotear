{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "model": "opusplan",
  "enabledPlugins": {
    "orchestrator@claude-agents": true,
    "analysis@claude-agents": true,
    "qa@claude-agents": true,
    "security@claude-agents": true,
    "design@claude-agents": true,
    "modern-web-guidance@claude-agents": true,
    "frontend-design@anthropic-plugin-directory": true,
    "small-business@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-agents": {
      "source": {
        "source": "github",
        "repo": "agusgut0/claude-agents"
      }
    }
  }
}
